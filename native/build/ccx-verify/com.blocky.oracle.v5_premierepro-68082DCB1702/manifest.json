{
  "manifestVersion": 6,
  "id": "com.blocky.oracle.v5",
  "name": "Oracle",
  "version": "2.0.14",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "26.3.0"
  },
  "addon": {
    "name": "oracle-native-drag.uxpaddon"
  },
  "requiredPermissions": {
    "localFileSystem": "fullAccess",
    "enableAddon": true,
    "ipc": {
      "enablePluginCommunication": true
    },
    "network": {
      "domains": "all"
    }
  },
  "entrypoints": [
    {
      "id": "oraclePanel",
      "type": "panel",
      "minimumSize": {
        "width": 300,
        "height": 320
      },
      "maximumSize": {
        "width": 2400,
        "height": 2400
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 560,
        "height": 760
      },
      "label": {
        "default": "Oracle"
      }
    },
    {
      "id": "oracleReplaysPanel",
      "type": "panel",
      "minimumSize": {
        "width": 300,
        "height": 320
      },
      "maximumSize": {
        "width": 2400,
        "height": 2400
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 680,
        "height": 760
      },
      "label": {
        "default": "Oracle Replays"
      }
    },
    {
      "id": "oracleCurvesPanel",
      "type": "panel",
      "minimumSize": {
        "width": 300,
        "height": 320
      },
      "maximumSize": {
        "width": 2400,
        "height": 2400
      },
      "preferredDockedSize": {
        "width": 520,
        "height": 620
      },
      "preferredFloatingSize": {
        "width": 900,
        "height": 760
      },
      "label": {
        "default": "Oracle Curves"
      }
    },
    {
      "id": "oracleQuickApplyPanel",
      "type": "panel",
      "minimumSize": {
        "width": 300,
        "height": 320
      },
      "maximumSize": {
        "width": 2400,
        "height": 2400
      },
      "preferredDockedSize": {
        "width": 420,
        "height": 720
      },
      "preferredFloatingSize": {
        "width": 760,
        "height": 760
      },
      "label": {
        "default": "Oracle Quick Apply"
      }
    },
    {
      "id": "oracleQuickApplyCommand",
      "type": "command",
      "label": {
        "default": "Open Oracle Quick Apply"
      }
    }
  ]
}